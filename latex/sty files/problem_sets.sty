\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{problem_sets}[2026/03/26 EA2 Problem Set Style]

% ─── Packages ────────────────────────────────────────────────────────────────

\RequirePackage{xparse}
\RequirePackage{etoolbox}
\RequirePackage[margin=1in]{geometry}
\RequirePackage{setspace}
\RequirePackage{changepage}
\RequirePackage[explicit,noindentafter]{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage{extramarks}
\RequirePackage{lmodern}
\RequirePackage[T1]{fontenc}
\RequirePackage{parskip}
\RequirePackage{amsmath,amssymb,amsthm}
\RequirePackage{mathtools}
\RequirePackage{xcolor}
\RequirePackage{framed}
\RequirePackage{footnote}
\RequirePackage{centernot}
\RequirePackage{bbm}
  \DeclareMathAlphabet\mathbbm{U}{fplmbb}{m}{n}

% ─── Options ─────────────────────────────────────────────────────────────────

\newbool{shaded}       \setbool{shaded}{true}
\newbool{showbody}     \setbool{showbody}{true}
\newbool{showsquare}   \setbool{showsquare}{true}
\newbool{showscratchwork} \setbool{showscratchwork}{true}

\DeclareOption{noshaded}      {\setbool{shaded}{false}}
\DeclareOption{hidebody}      {\setbool{showbody}{false}}
\DeclareOption{hidesquare}    {\setbool{showsquare}{false}}
\DeclareOption{hidescratchwork}{\setbool{showscratchwork}{false}}
\DeclareOption{hidesolutions} {\AtEndOfPackage{\setbool{showsolutions}{false}}}
\DeclareOption{hidereflections}{\AtEndOfPackage{\setbool{showreflections}{false}}}
\ProcessOptions\relax

% ─── Spacing & Fonts ─────────────────────────────────────────────────────────

\onehalfspacing
\renewcommand{\qedsymbol}{$\blacksquare$}

% ─── Formatting helpers ───────────────────────────────────────────────────────

\newcommand{\partformatting}{\bfseries}
\newcommand{\sectionformatting}{\bfseries}
\newcommand{\subsectionformatting}{\bfseries\slshape}
\newcommand{\titleformatting}{}
\newcommand{\Problem}{Problem}

% ─── Section / Part headers ──────────────────────────────────────────────────

\renewcommand{\partname}{Part}

\titleformat{\part}[display]
    {\vfill\partformatting\Large\filcenter}
    {\partname\ \thepart}
    {1em}
    {\Huge #1 \vfill \vfill}
    [{\addcontentsline{problems}{part}{\partformatting \partname\ \thepart \ #1}}]
\titleclass{\part}{page}

% clear page before section 2+
\newcommand{\sectionbreak}{\ifnum\value{section}>1\clearpage\fi}

\titleformat{\section}
    {\sectionformatting\large}
    {\Problem\ \thesection}
    {1em}
    {#1}
    [{%
        \addcontentsline{problems}{section}{\sectionformatting \Problem\ \thesection \ #1}%
        \nobreak\extramarks{}{\Problem\ \thesection\ continued on next page\ldots}\nobreak{}%
        \nobreak\extramarks{\Problem\ \thesection\ (continued)}{\Problem\ \thesection\ continued on next page\ldots}\nobreak{}%
    }]
\titlespacing{\section}{0em}{0em}{0.5em}

\titleformat{name=\section,numberless}
    {\sectionformatting\large}
    {}
    {1em}
    {#1}
    [{%
        \addcontentsline{problems}{section}{\sectionformatting #1}%
        \nobreak\extramarks{}{}\nobreak{}%
        \nobreak\extramarks{}{}\nobreak{}%
    }]
\titlespacing{name=\section,numberless}{-1.3em}{0em}{0.5em}

\renewcommand{\thesubsection}{\alph{subsection}}
\titleformat{\subsection}[runin]
    {\subsectionformatting}{Part (\thesection.\thesubsection)}{0.5em}{#1}
\titlespacing{\subsection}{0em}{0.5em}{1em}

\renewcommand{\thesubsubsection}{\roman{subsubsection}}
\titleformat{\subsubsection}[runin]
    {\subsectionformatting}{Subpart (\thesection.\thesubsection.\thesubsubsection)}{0.5em}{#1}
\titlespacing{\subsubsection}{0em}{0.5em}{1em}

% ─── Class / Due commands ────────────────────────────────────────────────────

\newcommand{\class}[1]{\renewcommand\@class{#1}}
\newcommand{\@class}{}
\newcommand{\due}{}

% ─── Title ───────────────────────────────────────────────────────────────────

\renewcommand{\maketitle}{%
    \begingroup
    \renewcommand{\and}{, }%
    \renewcommand{\thefootnote}{\@fnsymbol\c@footnote}%
    \let\footnote\thanks
    \thispagestyle{empty}%
    \vspace*{-5em}%
    \noindent\rule{\textwidth}{1pt}\\[7pt]%
    \makebox[\textwidth][s]{%
        \makebox[0pt][l]{\@author}%
        \hfill
        {\titleformatting \textbf{\@class, \@title}}%
        \hfill
        \makebox[0pt][r]{\due\@date}%
    }\par\nointerlineskip\vspace{4pt}%
    \noindent\rule{\textwidth}{1pt}\par%
    \@thanks
    \endgroup
    \setcounter{footnote}{0}%
}

\renewcommand{\and}{, }

% ─── Headers & Footers ───────────────────────────────────────────────────────

\pagestyle{fancy}
\renewcommand{\footrulewidth}{0.4pt}
\fancyhead{}\fancyfoot{}
\fancyhead[L]{\@author}
\fancyhead[R]{\firstxmark}
\fancyfoot[L]{\lastxmark}
\fancyfoot[C]{\thepage}
\fancyfoot[R]{{\let\thanks\@gobble\@class, \@title}}  % drop any \thanks mark from the footer

% ─── Table of Contents helpers ───────────────────────────────────────────────

\NewDocumentCommand{\listofproblemstitleformatting}{m}{\sectionformatting #1}
\NewDocumentCommand{\listofproblems}{O{} O{0.5in} O{0.5in} O{0.8}}{
    \begin{spacing}{#4}
        \begin{adjustwidth}{#2}{#3}
            \ifstrempty{#1}{}{\vspace*{1em}\centerline{\listofproblemstitleformatting{#1}}}
            \@starttoc{problems}
        \end{adjustwidth}
    \end{spacing}
}

% ─── leftbar environment ─────────────────────────────────────────────────────

\RenewDocumentEnvironment{leftbar}{m O{white} O{\hsize}}{%
    \def\FrameCommand{%
        {\color{#1}\vrule width \ifbool{shaded}{1pt}{3pt}}%
        \hspace{0pt}%
        \ifstrequal{#2}{white}{\fboxsep=0pt}{\fboxsep=\FrameSep}%
        \ifbool{shaded}{\colorbox{#2}}{}%
    }%
    \MakeFramed{\hsize#3\advance\hsize-\width\FrameRestore}%
}{%
    \endMakeFramed
}
\makesavenoteenv{leftbar}

% ─── Theorem style factory ───────────────────────────────────────────────────

\NewDocumentCommand{\environmenttitleformatting}{}{\sffamily\bfseries}
\NewDocumentCommand{\contentsentryformatting}{}{\sffamily}

\NewDocumentCommand{\createtheoremstyle}{m m O{5pt}}{
    \newtheoremstyle{#1}
        {\topsep}{\topsep}{}{}{\environmenttitleformatting}{:}{#3}
        {%
            \thmname{##1}\thmnumber{ ##2}\thmnote{ (##3)}%
            \ifstrempty{##2##3}{}%
                {\addcontentsline{#2}{section}{\protect\contentsentryformatting##1~\ifstrempty{##2}{\phantom{1}}{##2}~\ifstrempty{##3}{}{##3}}}%
        }%
}

\NewDocumentCommand{\contentstitleformatting}{m}{\centerline{\sffamily\bfseries #1}}

\NewDocumentCommand{\mylistof}{m O{} O{0.5in} O{0.5in} O{0}}{
    \vspace{-0.25em}
    \begin{spacing}{#5}
        \begin{adjustwidth}{#3}{#4}
            \ifstrempty{#2}{}{\vspace*{1em}{\contentstitleformatting{#2}}}%
            \@starttoc{#1}
        \end{adjustwidth}
    \end{spacing}
    \vspace*{2.5em}
}

\NewDocumentCommand{\createtheorem}{m m m m o o}{
    \theoremstyle{#1}
    \newtheorem{my#2}{#3}
    \newtheorem*{my#2*}{#3}
    \NewDocumentEnvironment{#2}{o +b}%
        {%
            \IfNoValueTF{##1}{\begin{my#2}}{\begin{my#2}[##1]}%
            \IfValueTF{#5}{%
                \IfValueTF{#6}{\begin{leftbar}{#4}[#5][#6]}{\begin{leftbar}{#4}[#5]}%
            }{%
                \IfValueTF{#6}{\begin{leftbar}{#4}[#6]}{\begin{leftbar}{#4}}%
            }%
            \ifbool{showbody}{##2}{\phantom{hidden}}%
            \end{leftbar}%
            \end{my#2}%
        }{}%
    \NewDocumentEnvironment{#2*}{o +b}%
        {%
            \IfNoValueTF{##1}{\begin{my#2*}}{\begin{my#2*}[##1]}%
            \IfValueTF{#5}{%
                \IfValueTF{#6}{\begin{leftbar}{#4}[#5][#6]}{\begin{leftbar}{#4}[#5]}%
            }{%
                \IfValueTF{#6}{\begin{leftbar}{#4}[#6]}{\begin{leftbar}{#4}}%
            }%
            \ifbool{showbody}{##2}{\phantom{hidden}}%
            \end{leftbar}%
            \end{my#2*}%
        }{}%
}

% ─── Colors ──────────────────────────────────────────────────────────────────

\newcommand{\definitionleftbarcolor}{blue}
\newcommand{\definitionfillcolor}{blue!10}
\newcommand{\axiomleftbarcolor}{brown}
\newcommand{\axiomfillcolor}{brown!10}
\newcommand{\assumptionleftbarcolor}{brown}
\newcommand{\assumptionfillcolor}{brown!10}
\newcommand{\exampleleftbarcolor}{black}
\newcommand{\examplefillcolor}{white}
\newcommand{\questionleftbarcolor}{orange}
\newcommand{\questionfillcolor}{orange!20}
\newcommand{\answerleftbarcolor}{green}
\newcommand{\answerfillcolor}{green!7}
\newcommand{\exerciseleftbarcolor}{orange}
\newcommand{\exercisefillcolor}{orange!10}
\newcommand{\remarkleftbarcolor}{black}
\newcommand{\remarkfillcolor}{white}
\newcommand{\theoremleftbarcolor}{violet}
\newcommand{\theoremfillcolor}{violet!20}
\newcommand{\lemmaleftbarcolor}{violet}
\newcommand{\lemmafillcolor}{violet!10}
\newcommand{\propositionleftbarcolor}{violet}
\newcommand{\propositionfillcolor}{violet!15}
\newcommand{\conjectureleftbarcolor}{violet}
\newcommand{\conjecturefillcolor}{violet!15}
\newcommand{\corollaryleftbarcolor}{violet}
\newcommand{\corollaryfillcolor}{violet!15}
\newcommand{\factleftbarcolor}{violet}
\newcommand{\factfillcolor}{violet!15}

% ─── Theorem environments ────────────────────────────────────────────────────

\createtheoremstyle{mydefinitions}{def}
\createtheorem{mydefinitions}{definition}{Definition}{\definitionleftbarcolor}[\definitionfillcolor]
\providecommand*\mydefinitionautorefname{Definition}

\createtheoremstyle{myaxioms}{axm}
\createtheorem{myaxioms}{axiom}{Axiom}{\axiomleftbarcolor}[\axiomfillcolor]

\createtheoremstyle{myassumptions}{asm}
\createtheorem{myassumptions}{assumption}{Assumption}{\assumptionleftbarcolor}[\assumptionfillcolor]

\createtheoremstyle{myexamples}{exm}
\createtheorem{myexamples}{example}{Example}{\exampleleftbarcolor}[\examplefillcolor]

\createtheoremstyle{myquestions}{qsn}
\createtheorem{myquestions}{question}{Question}{\questionleftbarcolor}[\questionfillcolor]

\createtheoremstyle{myanswers}{ans}
\createtheorem{myanswers}{answer}{Answer}{\answerleftbarcolor}[\answerfillcolor]

\createtheoremstyle{myexercises}{qsn}
\createtheorem{myexercises}{exercise}{Exercise}{\exerciseleftbarcolor}[\exercisefillcolor]

\createtheoremstyle{myremarks}{rmk}
\createtheorem{myremarks}{remark}{Remark}{\remarkleftbarcolor}[\remarkfillcolor]

\createtheoremstyle{mytheorems}{thm}
\createtheorem{mytheorems}{theorem}{Theorem}{\theoremleftbarcolor}[\theoremfillcolor]
\providecommand*\mytheoremautorefname{Theorem}
\createtheorem{mytheorems}{lemma}{Lemma}{\lemmaleftbarcolor}[\lemmafillcolor]
\providecommand*\mylemmaautorefname{Lemma}
\createtheorem{mytheorems}{proposition}{Proposition}{\propositionleftbarcolor}[\propositionfillcolor]
\createtheorem{mytheorems}{conjecture}{Conjecture}{\conjectureleftbarcolor}[\conjecturefillcolor]
\createtheorem{mytheorems}{corollary}{Corollary}{\corollaryleftbarcolor}[\corollaryfillcolor]
\createtheorem{mytheorems}{fact}{Fact}{\factleftbarcolor}[\factfillcolor]

% ─── Proof / Sketch ──────────────────────────────────────────────────────────

\newcommand{\proofleftbarcolor}{magenta}
\newcommand{\prooffillcolor}{magenta!5}
\newcommand{\proofwidth}{0.95\hsize}
\newcommand{\sketchleftbarcolor}{magenta}
\newcommand{\sketchfillcolor}{magenta!5}
\newcommand{\sketchwidth}{0.95\hsize}

\RenewDocumentEnvironment{proof}{o +b}{%
    \begin{leftbar}{\proofleftbarcolor}[\prooffillcolor][\proofwidth]
        \noindent\textit{Proof\IfValueT{#1}{ (#1)}. }%
        \ifbool{showbody}{#2}{\phantom{hidden}}%
        \hfill\qedsymbol
    \end{leftbar}%
}{}

\NewDocumentEnvironment{sketch}{o +b}{%
    \begin{leftbar}{\sketchleftbarcolor}[\sketchfillcolor][\sketchwidth]
        \noindent\textit{Sketch\IfValueT{#1}{ (#1)}. }%
        \ifbool{showbody}{#2}{\phantom{hidden}}%
        \hfill\qedsymbol
    \end{leftbar}%
}{}

% ─── Colored environments (solution, reflection) ──────────────────────────────

\NewDocumentCommand{\newcoloredenvironment}{m m m m m}{
    \newbool{#2}
    \setbool{#2}{true}
    \NewDocumentEnvironment{#1}{O{#3} O{#4} +b}{%
        \ifbool{#2}{\begin{leftbar}{##1}[##2][\hsize]}{}%
        \ifbool{#2}{##3}{}%
    }{%
        \ifbool{#2}{#5}{}%
        \ifbool{#2}{\end{leftbar}}{}%
        \nobreak
    }%
}

\newcommand{\solutionleftbarcolor}{gray}
\newcommand{\solutionfillcolor}{gray!20}
\newcoloredenvironment{solution}{showsolutions}{\solutionleftbarcolor}{\solutionfillcolor}{}

\newcommand{\reflectionleftbarcolor}{teal}
\newcommand{\reflectionfillcolor}{teal!5}
\newcoloredenvironment{reflection}{showreflections}{\reflectionleftbarcolor}{\reflectionfillcolor}{}

% Patch solution/reflection to emit extramarks
\let\oldsolution\solution
\let\endoldsolution\endsolution
\renewenvironment{solution}{\oldsolution}{%
    \endoldsolution
    \nobreak\extramarks{\Problem\ \thesection\ (continued)}{\Problem\ \thesection\ continued on next page\ldots}\nobreak{}%
    \nobreak\extramarks{\Problem\ \thesection}{}\nobreak{}%
}

\let\oldreflection\reflection
\let\endoldreflection\endreflection
\renewenvironment{reflection}{\oldreflection}{%
    \endoldreflection
    \nobreak\extramarks{\Problem\ \thesection\ (continued)}{\Problem\ \thesection\ continued on next page\ldots}\nobreak{}%
    \nobreak\extramarks{\Problem\ \thesection}{}\nobreak{}%
}

% ─── Question box ────────────────────────────────────────────────────────────
%  Gray left bar + gray!15 fill — matches the PDF

\newenvironment{questionbox}[1][Question]{%
    \def\FrameCommand{%
        {\color{gray}\vrule width 1pt}%
        \hspace{0pt}%
        \fboxsep=\FrameSep
        \colorbox{gray!15}%
    }%
    \MakeFramed{\hsize\hsize\advance\hsize-\width\FrameRestore}%
    \noindent{\sffamily\bfseries #1:}\quad\ignorespaces
}{%
    \endMakeFramed
}

% ─── Compartment ─────────────────────────────────────────────────────────────

\NewDocumentCommand{\compartmenttitleformatting}{m}{\noindent{\sffamily\bfseries{#1}}}
\NewDocumentEnvironment{compartment}{o +b}{%
    \begin{framed}%
        \IfValueTF{#1}{\compartmenttitleformatting{#1}}{}%
        #2%
}{%
    \end{framed}%
}

