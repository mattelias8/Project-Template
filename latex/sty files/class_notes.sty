% Highlighting and notes
\newcommand{\vocab}[1]{\textbf{\color{blue}#1}}
\newcommand{\important}[1]{\textbf{\color{red}#1}}
\newcommand{\sidenote}[1]{\if@marginnotes\marginnote{#1}\else\footnote{#1}\fi}

% Box for key results
\newcommand{\keyresult}[1]{%
    \begin{center}
