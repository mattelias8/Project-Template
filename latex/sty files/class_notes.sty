% ============================================================================
% USEFUL COMMANDS
% ============================================================================

% Course information commands
\newcommand{\course}[1]{\gdef\@course{#1}}
\newcommand{\lecturer}[1]{\gdef\@lecturer{#1}}
\newcommand{\semester}[1]{\gdef\@semester{#1}}
\newcommand{\lecturedate}[1]{\gdef\@lecturedate{#1}}

% Title page formatting for entire course notes
\newcommand{\makecovertitle}{
    \begin{titlepage}
        \centering
        \vspace*{2cm}
        {\Huge\bfseries\@title\par}
        \vspace{1.5cm}
        \ifdef{\@course}{{\LARGE\@course\par}}{}
        \vspace{1cm}
        \ifdef{\@lecturer}{{\Large Lecturer: \@lecturer\par}}{}
        \vspace{0.5cm}
        \ifdef{\@semester}{{\Large\@semester\par}}{}
        \vfill
        \ifdef{\@author}{{\large Notes by: \@author\par}}{}
        \vspace{0.5cm}
        {\large\@date\par}
    \end{titlepage}
}

% Simple title for standalone chapters
\newcommand{\makechaptertitle}{
    \begin{center}
        {\Large\bfseries\@title}\\[0.5em]
        \ifdef{\@course}{{\large\@course}\\}{}
        \ifdef{\@lecturer}{Lecturer: \@lecturer\\}{}
        \ifdef{\@semester}{\@semester\\}{}
        \ifdef{\@author}{Notes by: \@author}{}
    \end{center}
    \vspace{1em}
}

% Lecture header command for individual lectures within document
\newcommand{\lecture}[2]{
    \section{#1}
    \if@marginnotes
        \marginnote{\small\textit{#2}}
    \fi
}

% Topic command (creates a new part)
\newcommand{\topic}[1]{\part{#1}}

% ============================================================================
% MATHEMATICAL OPERATORS
