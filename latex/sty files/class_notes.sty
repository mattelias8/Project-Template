% aaron_notes.sty
% LaTeX package for lecture notes
% Provides theorem environments, formatting, and useful commands
% Compatible with subfiles package for modular document structure

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{aaron_notes}[2025/01/14 Lecture Notes Style Package]

% ============================================================================
% PACKAGE OPTIONS
% ============================================================================

\newif\if@coloredtheorems\@coloredtheoremsfalse
\DeclareOption{coloredtheorems}{\@coloredtheoremstrue}

\newif\if@fancyheaders\@fancyheadersfalse
\DeclareOption{fancyheaders}{\@fancyheaderstrue}

\newif\if@marginnotes\@marginnotesfalse
\DeclareOption{marginnotes}{\@marginnotestrue}

\newif\if@standalone\@standalonefalse
\DeclareOption{standalone}{\@standalonetrue}

\ProcessOptions\relax

% ============================================================================
% REQUIRED PACKAGES
% ============================================================================

% Math packages
\RequirePackage{amsmath,amsthm,amssymb,amsfonts}
\RequirePackage{mathtools}
\RequirePackage{bbm}

% Formatting
\RequirePackage[margin=1in]{geometry}
\RequirePackage{setspace}
\RequirePackage{parskip}
\RequirePackage{caption}

% Graphics and colors
\RequirePackage{graphicx}
\RequirePackage{xcolor}

% For highlighted boxes
\RequirePackage{tcolorbox}
\tcbuselibrary{theorems,skins,breakable}

% Lists and enumeration
\RequirePackage{enumerate}
\RequirePackage{enumitem}

% Table of contents formatting
\RequirePackage{titletoc}
\RequirePackage{titlesec}

% Hyperlinks
\RequirePackage[colorlinks=true,linkcolor=blue,citecolor=blue,urlcolor=blue]{hyperref}

% Headers (conditional)
\if@fancyheaders
    \RequirePackage{fancyhdr}
    \pagestyle{fancy}
    \fancyhf{}
    \fancyhead[L]{\leftmark}
    \fancyhead[R]{\thepage}
    \renewcommand{\headrulewidth}{0.4pt}
\fi

% Margin notes (conditional)
\if@marginnotes
    \RequirePackage{marginnote}
    \renewcommand*{\marginfont}{\footnotesize\itshape}
\fi

% ============================================================================
% TABLE OF CONTENTS FORMATTING
% ============================================================================

% Customize TOC depth
\setcounter{tocdepth}{2}

% Part formatting in TOC
\titlecontents{part}
    [0em]
    {\addvspace{1em}\bfseries\large}
    {\contentslabel{2em}}
    {}
    {\hfill\contentspage}
    [\addvspace{0.5em}]

% Section formatting in TOC
\titlecontents{section}
    [1.5em]
    {\addvspace{0.3em}}
    {\contentslabel{2.3em}}
    {\hspace*{-2.3em}}
    {\titlerule*[0.5pc]{.}\contentspage}

% Subsection formatting in TOC
\titlecontents{subsection}
    [3.8em]
    {}
    {\contentslabel{2.3em}}
    {\hspace*{-2.3em}}
    {\titlerule*[0.5pc]{.}\contentspage}

% ============================================================================
% SECTION FORMATTING
% ============================================================================

% Part formatting (for major topics)
\titleformat{\part}
    [display]
    {\normalfont\huge\bfseries\centering}
    {\partname\ \thepart}
    {20pt}
    {\Huge}

% Section formatting (for subtopics/lectures)
\titleformat{\section}
    {\normalfont\Large\bfseries}
    {\thesection}
    {1em}
    {}

% Subsection formatting
\titleformat{\subsection}
    {\normalfont\large\bfseries}
    {\thesubsection}
    {1em}
    {}

% ============================================================================
% COLORS FOR THEOREM ENVIRONMENTS
% ============================================================================

\definecolor{theoremcolor}{RGB}{0,100,200}
\definecolor{definitioncolor}{RGB}{0,150,100}
\definecolor{lemmacolor}{RGB}{150,0,150}
\definecolor{propositioncolor}{RGB}{200,100,0}
\definecolor{corollarycolor}{RGB}{100,0,100}
\definecolor{remarkcolor}{RGB}{100,100,100}
\definecolor{examplecolor}{RGB}{0,128,128}
\definecolor{overviewcolor}{RGB}{140,80,200}
\definecolor{highlightcolor}{RGB}{220,235,255}
\definecolor{highlightborder}{RGB}{70,130,220}
\definecolor{notecolor}{RGB}{255,250,205}
\definecolor{noteborder}{RGB}{218,165,32}

% ============================================================================
% THEOREM ENVIRONMENTS
% ============================================================================

\if@coloredtheorems
    
    \newtcbtheorem[number within=section]{lemma@tcb}{Lemma}{
        colback=lemmacolor!5,
        colframe=lemmacolor,
        fonttitle=\bfseries,
        separator sign none
    }{lem}
    \newenvironment{lemma}{\begin{lemma@tcb}{}}{\end{lemma@tcb}}
    
    \newtcbtheorem[number within=section]{proposition@tcb}{Proposition}{
        colback=propositioncolor!5,
        colframe=propositioncolor,
        fonttitle=\bfseries,
        separator sign none
    }{prop}
    \newenvironment{proposition}{\begin{proposition@tcb}{}}{\end{proposition@tcb}}
    
    \newtcbtheorem[number within=section]{corollary@tcb}{Corollary}{
        colback=corollarycolor!5,
        colframe=corollarycolor,
        fonttitle=\bfseries,
        separator sign none
    }{cor}
    \newenvironment{corollary}{\begin{corollary@tcb}{}}{\end{corollary@tcb}}
    
    \newtcbtheorem[number within=section]{remark@tcb}{Remark}{
        colback=remarkcolor!5,
        colframe=remarkcolor,
        fonttitle=\bfseries,
        separator sign none
    }{rem}
    \newenvironment{remark}{\begin{remark@tcb}{}}{\end{remark@tcb}}
\else
    \theoremstyle{plain}
    \newtheorem{lemma}{Lemma}[section]
    \newtheorem{proposition}[lemma]{Proposition}
    \newtheorem{corollary}[lemma]{Corollary}
    
    \theoremstyle{definition}
    \newtheorem{exercise}[lemma]{Exercise}
    
    \theoremstyle{remark}
    \newtheorem{remark}[lemma]{Remark}
    \newtheorem{note}[lemma]{Note}
\fi

\renewenvironment{proof}{\textit{Proof.}}{\hfill$\square$\vspace{0.5em}}

% ============================================================================
% COLOURED BOX ENVIRONMENTS
% ============================================================================
% These four environments are always available regardless of package options.
% Each accepts an optional title: \begin{overview}[Title] ... \end{overview}

% Section overview box (purple) — use at the start of a section/lecture
\newtcolorbox{overview}[1][]{
    enhanced,
    colback=overviewcolor!8,
    colframe=overviewcolor,
    boxrule=1.5pt,
    arc=4pt,
    left=8pt, right=8pt, top=8pt, bottom=8pt,
    fontupper=\normalsize,
    title={\textbf{\S\ Overview}\ifx\relax#1\relax\else: #1\fi},
    fonttitle=\bfseries,
    coltitle=white,
    colbacktitle=overviewcolor,
    attach boxed title to top left={yshift=-2mm, xshift=6pt},
    boxed title style={arc=3pt, boxrule=0pt},
    breakable
}

% Theorem box (blue) — for stating results formally
\newtcolorbox{theorem}[1][]{
    enhanced,
    colback=theoremcolor!6,
    colframe=theoremcolor,
    boxrule=1.5pt,
    arc=4pt,
    left=8pt, right=8pt, top=8pt, bottom=8pt,
    fontupper=\normalsize,
    title={\textbf{Theorem}\ifx\relax#1\relax\else\ (#1)\fi},
    fonttitle=\bfseries,
    coltitle=white,
    colbacktitle=theoremcolor,
    attach boxed title to top left={yshift=-2mm, xshift=6pt},
    boxed title style={arc=3pt, boxrule=0pt},
    breakable
}

% Definition box (green) — for introducing new terms
\newtcolorbox{definition}[1][]{
    enhanced,
    colback=definitioncolor!6,
    colframe=definitioncolor,
    boxrule=1.5pt,
    arc=4pt,
    left=8pt, right=8pt, top=8pt, bottom=8pt,
    fontupper=\normalsize,
    title={\textbf{Definition}\ifx\relax#1\relax\else\ (#1)\fi},
    fonttitle=\bfseries,
    coltitle=white,
    colbacktitle=definitioncolor,
    attach boxed title to top left={yshift=-2mm, xshift=6pt},
    boxed title style={arc=3pt, boxrule=0pt},
    breakable
}

% Example box (teal) — for worked examples
\newtcolorbox{example}[1][]{
    enhanced,
    colback=examplecolor!6,
    colframe=examplecolor,
    boxrule=1.5pt,
    arc=4pt,
    left=8pt, right=8pt, top=8pt, bottom=8pt,
    fontupper=\normalsize,
    title={\textbf{Example}\ifx\relax#1\relax\else: #1\fi},
    fonttitle=\bfseries,
    coltitle=white,
    colbacktitle=examplecolor,
    attach boxed title to top left={yshift=-2mm, xshift=6pt},
    boxed title style={arc=3pt, boxrule=0pt},
    breakable
}

% ============================================================================
% HIGHLIGHTED KEY POINTS SECTION
